# to start the bot rename this file into ".env" (without "") and define the TOKEN and channel IDs.
# to get the channel or user id go in discord to Settings -> Advanced and activate the Developer Mode

# define values without spaces before/after =
TOKEN=PutHereYourTOKEN
BOT_NAME=<botname>
BUG_CHANNEL_ID=111
TICKET_CATEGORY_ID=222
GITHUB_TOKEN=PutHereYourGitHubToken

# Default target language for the /tl translation command
DEFAULT_TARGET_LANGUAGE=en

# Dashboard config (optional, only if using web dashboard)
# DASHBOARD_URL=http://localhost:6062
# DASHBOARD_SECRET=change-this-to-a-random-secret
# COOKIE_SECURE=true
